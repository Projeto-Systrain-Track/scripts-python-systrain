LOCAL_INPUT_CSV=*.csv
LOCAL_OUTPUT_CSV=trusted/maquinas_enriquecido_status.csv

CLIENT_OUTPUT_DIR=client
PROCESS_OUTPUT_DIR=client/processos

LAST_N=10
PROCESS_LAST_N=100
PROCESS_MAX_PER_READING=50

JSON_INDENT=4

FULL_CSV=false

CSV_GZIP=false

COMPACT_CSV_DEFAULT=true

NO_DB=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=0623
MYSQL_DATABASE=systraintrack

RBC_OFFLINE_GAP_MINUTES=5

SKIP_PROCESS_ALERTS=false

PROCESS_CPU_ALERT=15
PROCESS_MEMORY_PERCENT_ALERT=10
PROCESS_RSS_MB_ALERT=200
PROCESS_THREADS_ALERT=75

HIGH_PRIORITY_PROCESS_PREFIXES=RBC_
HIGH_PRIORITY_PROCESS_CPU_ALERT=2
HIGH_PRIORITY_PROCESS_MEMORY_PERCENT_ALERT=5
HIGH_PRIORITY_PROCESS_RSS_MB_ALERT=15

PROCESS_CPU_SPIKE_ALERT=5
PROCESS_MEMORY_SPIKE_ALERT=1
PROCESS_RSS_GROWTH_MB_ALERT=5

IMPORTANT_PROCESS_KEYWORDS=java,node,python,postgres,mysql,sqlserver,mongodb,redis,nginx,apache,httpd,docker,containerd